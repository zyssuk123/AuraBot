# AuraBot Environment Configuration
# Generated during Dockerization on 2026-05-14
# UPDATE THESE VALUES WITH YOUR ACTUAL API KEYS

# Display settings for GUI applications
DISPLAY=:0

# Gemini API Key for AI voice assistant features
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob Token for cloud gallery storage
# Get your token from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Camera device path
CAMERA_DEVICE=/dev/video0

# Application mode: detection, faceid, or both
APP_MODE=detection
